  m_Script: {fileID: 11500000, guid: d8c885f0dfcd61a46b5c031654a1346c, type: 3}
  m_Name: ChiefNpcDialogue
  m_EditorClassIdentifier: Assembly-CSharp::Game.Data.DialogueDataSo
  _dialogue:
  - 'The  <size=150%><sketchy><color=#8B0000>strix</color></sketchy></size> hath
    robbed us of the sun. '
  - 'Thou must vanquish the creature. '
  - First, seek the <color=#87CEFA><wave amplitude=4>fragments</wave></color> to
    enter its lair.
  - One of them rests in the forest.
  - When thou art ready, follow the road straight ahead.
  _letterDelayTime: 0.06
